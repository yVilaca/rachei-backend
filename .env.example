SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL (dev, CI e produção usam o mesmo motor)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rachei
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Chave Fernet para criptografia do secret TOTP em repouso.
# OBRIGATÓRIA — sem ela qualquer operação 2FA levanta ImproperlyConfigured.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use um secrets manager (AWS Secrets Manager, Doppler, etc.) em produção.
TOTP_ENCRYPTION_KEY=
